{
  "name": "proyecto-jest-propio",
  "version": "1.0.0",
  "description": "Evidencia de pruebas automatizadas con Jest (SENA) desarrollada con arquitectura propia.",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "test": "jest --runInBand",
    "test:ej1": "jest tests/unit/temperature.converter.spec.js",
    "test:ej2": "jest tests/unit/password.validator.spec.js",
    "test:ej3": "jest tests/unit/user.manager.spec.js",
    "test:ej4": "jest tests/integration/products.api.spec.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "jest",
    "testing",
    "supertest",
    "mongoose",
    "sena"
  ],
  "author": "Estudiante",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mongoose": "^8.15.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1"
  }
}
